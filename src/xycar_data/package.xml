<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xycar_data</name>
  <version>0.1.0</version>
  <description>Terminal teleop and camera-first AI dataset recorder for Xycar.</description>
  <maintainer email="moongunwoo7019@naver.com">Gunwoo Moon</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>xycar_cam</exec_depend>
  <exec_depend>xycar_lidar</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
