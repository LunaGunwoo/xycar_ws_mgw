+#include <gtest/gtest.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+#include "vesc_driver/datatypes.hpp"
+#include "vesc_driver/vesc_packet.hpp"
+#include "vesc_driver/vesc_packet_factory.hpp"
+
+namespace
+{
+
+using vesc_driver::Buffer;
+using vesc_driver::VescFrame;
+using vesc_driver::VescPacketFactory;
+using vesc_driver::VescPacketValues;
+
+void putInt16(Buffer * payload, size_t offset, int16_t value)
+{
+  const auto raw = static_cast<uint16_t>(value);
+  payload->at(offset) = static_cast<uint8_t>(raw >> 8);
+  payload->at(offset + 1) = static_cast<uint8_t>(raw & 0xff);
+}
+
+void putInt32(Buffer * payload, size_t offset, int32_t value)
+{
+  const auto raw = static_cast<uint32_t>(value);
+  payload->at(offset) = static_cast<uint8_t>(raw >> 24);
+  payload->at(offset + 1) = static_cast<uint8_t>((raw >> 16) & 0xff);
+  payload->at(offset + 2) = static_cast<uint8_t>((raw >> 8) & 0xff);
+  payload->at(offset + 3) = static_cast<uint8_t>(raw & 0xff);
+}
+
+Buffer makeFrame(const Buffer & payload)
+{
+  Buffer frame{2, static_cast<uint8_t>(payload.size())};
+  frame.insert(frame.end(), payload.begin(), payload.end());
+  const uint16_t crc = CRC::Calculate(
+    payload.data(), payload.size(), VescFrame::CRC_TYPE);
+  frame.push_back(static_cast<uint8_t>(crc >> 8));
+  frame.push_back(static_cast<uint8_t>(crc & 0xff));
+  frame.push_back(3);
+  return frame;
+}
+
+TEST(VescPacketFw218, DecodesLegacyValuesLayout)
+{
+  Buffer payload(56, 0);
+  payload[0] = vesc_driver::COMM_GET_VALUES;
+  putInt16(&payload, 13, 315);
+  putInt32(&payload, 15, -1234);
+  putInt32(&payload, 19, 456);
+  putInt16(&payload, 23, -125);
+  putInt32(&payload, 25, 12345);
+  putInt16(&payload, 29, 96);
+  putInt32(&payload, 31, 1111);
+  putInt32(&payload, 35, 2222);
+  putInt32(&payload, 39, 3333);
+  putInt32(&payload, 43, 4444);
+  putInt32(&payload, 47, -5555);
+  putInt32(&payload, 51, 6666);
+  payload[55] = 0;
+
+  const Buffer frame = makeFrame(payload);
+  int bytes_needed = 0;
+  std::string error;
+  const auto packet = VescPacketFactory::createPacket(
+    frame.begin(), frame.end(), &bytes_needed, &error);
+  const auto values = std::dynamic_pointer_cast<VescPacketValues>(packet);
+
+  ASSERT_NE(nullptr, values) << error;
+  EXPECT_EQ(0, bytes_needed);
+  EXPECT_DOUBLE_EQ(31.5, values->temp_pcb());
+  EXPECT_DOUBLE_EQ(-12.34, values->current_motor());
+  EXPECT_DOUBLE_EQ(4.56, values->current_in());
+  EXPECT_DOUBLE_EQ(-0.125, values->duty_now());
+  EXPECT_DOUBLE_EQ(12345.0, values->rpm());
+  EXPECT_DOUBLE_EQ(9.6, values->v_in());
+  EXPECT_DOUBLE_EQ(1111.0, values->amp_hours());
+  EXPECT_DOUBLE_EQ(2222.0, values->amp_hours_charged());
+  EXPECT_DOUBLE_EQ(3333.0, values->watt_hours());
+  EXPECT_DOUBLE_EQ(4444.0, values->watt_hours_charged());
+  EXPECT_DOUBLE_EQ(-5555.0, values->tachometer());
+  EXPECT_DOUBLE_EQ(6666.0, values->tachometer_abs());
+  EXPECT_EQ(0, values->fault_code());
+}
+
+}  // namespace
